# f1-predictor — variaveis de ambiente (copie para .env; .env e' gitignored)
# Jolpica (sucessor do Ergast) nao exige chave; a variavel fica para o caso
# de rate limit autenticado no futuro
ERGAST_API_KEY=
F1_ENVIRONMENT=development
F1_RAW_CACHE_DIR=./runtime/raw
F1_SNAPSHOT_DIR=./runtime/snapshots
F1_ARCHIVE_DIR=./runtime/archive
F1_DATABASE_URL=sqlite:///./runtime/f1.db
F1_OBJECT_STORAGE_URL=
F1_JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
F1_JOLPICA_TIMEOUT_SECONDS=30
# Canonical API-Sports name and accepted legacy aliases (same secret):
F1_API_SPORTS_KEY=
# API_SPORTS_F1_KEY=
# API_FOOTBALL_KEY=
F1_PREDICTIONS_LOG_PATH=
F1_BETS_LOG_PATH=
F1_EVENTS_PATH=
# There is intentionally no odds key: ODDS_UNAVAILABLE_FOR_F1.
